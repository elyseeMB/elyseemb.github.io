---
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Blog from "../components/Blog.astro";
import { filterByLocale, useTranslations } from "../i18n/utils.ts";
import { getPublishedPosts } from "../libs/pushisedPost.ts";

export type PropsBlog = CollectionEntry<"blog">;

const articles = await getPublishedPosts(
  "blog",
  filterByLocale(Astro.currentLocale),
);

const t = useTranslations(Astro.currentLocale);
---

<Layout>
  <div class="home">
    <Hero />
    {articles.length >= 1 && <Blog title={t("home.latestArticles")} />}
  </div>
</Layout>

<style>
  /* .home {
    overflow: hidden;
  } */
</style>
