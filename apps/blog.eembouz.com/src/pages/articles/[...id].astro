---
import type { GetStaticPaths } from "astro";
import { filterByLocale } from "../../i18n/utils.ts";
export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts("blog", filterByLocale("fr"));
  return posts.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}) satisfies GetStaticPaths;
import Page from "./_page.astro";
import { getPublishedPosts } from "../../libs/pushisedPost.ts";
---

<Page {...Astro.props} />
