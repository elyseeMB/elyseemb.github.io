---
import type { ReferenceDataEntry } from "astro:content";
import { getEntry, type CollectionEntry } from "astro:content";
import clsx from "clsx";
import { getTranslator } from "../libs/i18n.ts";
import BlockInfo from "./BlockInfo.astro";
import Label from "./Label.astro";
import ReadingTime from "./ReadingTime.astro";
import Writer from "./Writer.astro";

interface Props {
  className?: string;
  item: CollectionEntry<"series"> | CollectionEntry<"blog">;
  readingTime?: number;
  showSummary?: boolean;
  taxonomies?: ReferenceDataEntry<"taxonomies", string>[] | undefined;
}

const {
  item,
  readingTime,
  showSummary = true,
  taxonomies,
  className,
} = Astro.props;

const { title, pubDate, author, contentType, summary, ...props } = item.data;

const formatDate = Intl.DateTimeFormat(Astro.currentLocale, {
  dateStyle: "long",
}).format(pubDate);

const getTaxonomies = await Promise.all(
  taxonomies
    ? taxonomies?.map(
        async (taxonomy) => await getEntry(taxonomy.collection, taxonomy.id),
      )
    : [],
);
const cleanTitle = title.replace(/[^\p{L}\p{N}\s'']/gu, "");
const __ = await getTranslator(Astro.currentLocale);
---

<div class={clsx(className, "flex flex-col gap-5")}>
  <BlockInfo
    className="flex flex-col gap-4 md:col-span-2 lg:col-span-2 animate-blur-in"
  >
    <Label title={__("Résumé")} />
    <h1 class="text-base lg:text-2xl leading-tight text-balance w-full">
      {cleanTitle}
    </h1>
    <p class="text-[var(--color-secondary)] text-base lg:text-xl">
      {item.data.summary}
    </p>
  </BlockInfo>

  <div class="flex flex-col gap-5">
    <BlockInfo
      className="flex flex-col gap-4 text-base animate-blur-in animation-delay-200"
    >
      <div class="flex items-start gap-5 text-[var(--color-secondary)]">
        <Writer icon author={author} />
        <ReadingTime icon time={readingTime!} />
        <span class="flex items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-calendar-icon lucide-calendar"
            ><path d="M8 2v4"></path><path d="M16 2v4"></path><rect
              width="18"
              height="18"
              x="3"
              y="4"
              rx="2"></rect><path d="M3 10h18"></path></svg
          >
          {formatDate}</span
        >
      </div>
    </BlockInfo>

    <BlockInfo
      className="flex flex-col gap-4 animate-blur-in animation-delay-300"
    >
      {
        getTaxonomies && (
          <div class="flex gap-2 text-base text-[var(--color-secondary)]">
            {getTaxonomies.map((taxonomy) => (
              <div class="italic">{taxonomy?.data.name}</div>
            ))}
          </div>
        )
      }
    </BlockInfo>
  </div>
</div>

<style>
  .info {
  }
</style>
