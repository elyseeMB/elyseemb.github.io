---
import HeroComponent from "@portfolio/ui/Hero";
import { getLink } from "../libs/i18n.ts";
import { getTranslator } from "../libs/i18n.ts";
const href = getLink(Astro, "/articles");
const __ = await getTranslator(Astro.currentLocale);
---

<HeroComponent
  title={__("Blog - Conseils, découvertes et inspirations ")}
  action={{ name: __("Mes dernfiers articles"), url: href }}
  description={__(
    "Curieux de sciences, développeur, compositeur et amateur d'art. Je partage mes réflexions sur la programmation, la musique, la science ou parfois des analyses originales sur la littérature."
  )}
/>
