---
import HeroComponent from "@portfolio/ui/Hero";
import { useTranslations } from "../i18n/utils.ts";
const t = useTranslations(Astro.currentLocale);
---

<HeroComponent title={t("home.heroTitle")}>
  <div slot="description" class="animate-blur-in animation-delay-300">
    <p>
      {
        t(
          "home.heroDescription",
        )
      }
    </p>
  </div>
</HeroComponent>
