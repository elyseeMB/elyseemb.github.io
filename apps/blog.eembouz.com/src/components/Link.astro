---
interface Props {
  href: string;
  class?: string;
}
const { href, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    "relatvie w-full h-full md:col-span-4 relative block",
    className,
  ]}
>
  <span aria-hidden="true" class="absolute inset-0 w-full h-full"></span>
  <slot />
</a>
