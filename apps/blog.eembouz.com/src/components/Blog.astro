---
import { getCollection } from "astro:content";
import type { OptionsCollection } from "../../config.ts";
import { itemNormalizer } from "../functions/article.ts";
import { filterLang, getTranslator } from "../libs/i18n.ts";
import Card from "./Card.astro";
import { getPublishedPosts } from "../libs/pushisedPost.ts";

interface Props {
  title?: string;
  limit?: number;
}

const allPages = await getPublishedPosts(
  "blog",
  filterLang(Astro.currentLocale)
);

const { title, limit } = Astro.props;

const doc = itemNormalizer(allPages);

const options: OptionsCollection = {
  showYear: false,
};
const __ = await getTranslator(Astro.currentLocale);
---

<section class="blog">
  <!-- {
      title && (
        <h3 class="title animate-slide-in animation-delay-300">{title}</h3>
      )
    } -->
  <div class="flex flex-col divide-y divide-[var(--secondary)]">
    <div
      class="hidden pb-5 lg:bloc lg:text-sm lg:grid lg:grid-cols-5 w-full animate-fade-in animation-delay-300"
    >
      <div>{__("/ DATE")}</div>
      <div>{__("/ TITRE")}</div>
    </div>
    <div data-list__articles class="flex flex-1 flex-col">
      {doc.map((collection) => <Card {...collection} options={options} />)}
    </div>
  </div>
  <!-- <div class="w-[400px]"></div> -->
</section>

<style>
  .blog {
    padding-bottom: 5rem;
  }

  .blog a {
    display: inline-flex;
  }
</style>
