---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { filterByLocale, resolveContentLocale } from "../../i18n/utils.ts";
import Page from "../_WritingPage.astro";

export const getStaticPaths = (async () => {
  const items = await getCollection(
    "writings",
    (entry) =>
      entry.data.status === "online" &&
      filterByLocale(resolveContentLocale("zh"))(entry),
  );
  return items.map((writing) => ({
    params: { id: writing.id.split("/").at(-1) },
    props: { writing },
  }));
}) satisfies GetStaticPaths;

const { writing } = Astro.props;
---

<Page writing={writing} />
