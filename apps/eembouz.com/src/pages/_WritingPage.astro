---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import MusicPlayer from "../components/MusicPlayer.tsx";
import { useTranslations } from "../i18n/utils.ts";

export type Props = {
  writing: CollectionEntry<"writings">;
};

const { writing } = Astro.props;
const { Content } = await render(writing);

const { title, pubDate, thumbnail, music } = writing.data;

const locale = Astro.currentLocale ?? "en";

const t = useTranslations(locale);

const seo = {
  title,
  typeContent: "article" as const,
  image: thumbnail ? `${Astro.url.origin}${thumbnail}` : undefined,
};
---

<Layout {...seo}>
  <section
    data-markdown
    class="w-full animate-blur-in animation-delay-300 pb-30"
  >
    <div class="grid grid-cols-1 gap-2 font-sans">
      <h1 class="font-normal">{title}</h1>
      <span class="text-sm text-[var(--color-secondary)]">
        {
          Intl.DateTimeFormat(locale, {
            dayPeriod: "long",

            day: "numeric",
            month: "short",
            year: "numeric",
          }).format(pubDate)
        }
      </span>
    </div>

    {
      music && (
        <MusicPlayer
          client:load
          videoId={music}
          playLabel={t("music.play")}
          pauseLabel={t("music.pause")}
        />
      )
    }

    <div class="pt-10">
      <div class="prose font-sans leading-relaxed!">
        <Content />
      </div>
    </div>
  </section>
</Layout>

<style>
  .projects__title {
    padding-bottom: 0.5rem;
  }

  .writings {
    width: 100%;
    height: 100%;
    padding-bottom: 5rem;
  }

  .techo__name {
    font-family: "Inter" !important;
    font-weight: 100 !important;
    padding-bottom: 1rem;
  }

  .frameworks .list {
    display: flex;
    flex-direction: column;
    gap: 0;
    line-height: 1.6;
  }

  .frameworks .list li {
    padding-bottom: 0.5rem;
  }

  .frameworks .list .framework__name {
    color: var(--color-primary);
  }
</style>
