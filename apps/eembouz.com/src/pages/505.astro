---
import LayoutError from "../layouts/LayoutError.astro";

interface Props {
  error: unknown;
}

const { error } = Astro.props;
---

<LayoutError>
  <div class="container">
    <div class="wrapper">
      <div>
        {error instanceof Error ? error.message : "Unknown error"}<div></div>
      </div>
    </div>
  </div>
</LayoutError>
