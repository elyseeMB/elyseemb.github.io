---
import "@portfolio/ui/GlobalCSS";
import Scripts from "../components/Scripts.astro";
import Seo from "../components/Seo.astro";
import Footer from "../components/shared/Footer.astro";
import Header from "../components/shared/Header.astro";
import BlurEffect from "../components/BlurEffect.astro";
import ThemeManager from "@portfolio/ui/ThemeManager";
import Smooth from "@portfolio/ui/Smooth";

const {
  title,
  description,
  image,
  url = Astro.url.href,
  typeContent,
  fullWidth,
} = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale}>
  <head>
    <Seo
      title={title}
      description={description}
      typeContent={typeContent}
      image={image}
      url={url}
    />
    <Scripts />
    <ThemeManager />
  </head>
  <body class="font-sans text-base lg:text-lg">
    <div class="mx-auto flex max-w-[652px] flex-col pb-20">
      <!-- <Header /> -->
    </div>
    <main>
      <div class:list={[fullWidth ? "container-full" : "container"]}>
        <div class="page-wrapper">
          <BlurEffect />
          <slot />
        </div>
      </div>
    </main>

    <div class="mx-auto max-w-[652px] mb-16 px-5">
      <Footer />
    </div>

    <Smooth />
  </body>
</html>

<script>
  import { onLoadClientRouter } from "@portfolio/ui/client";

  onLoadClientRouter(() => {
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      document.documentElement.classList.add("dark");
      document.documentElement.style.colorScheme = "dark";
    }
  });
</script>
