---
import HeroComponent from "@portfolio/ui/Hero";
import { useTranslations } from "../i18n/utils.ts";
const t = useTranslations(Astro.currentLocale);
---

<div>
  <div class="pb-10 gap-10 flex flex-col justify-center items-center">
    <h1 class="text-xl">Hi ! I'm Elysee Mboussa</h1>
    <div
      class="w-80 lg:w-100 m-auto rotate-4 flex flex-col gap-2 p-5 rounded-lg bg-[var(--accent)] dark:bg-white"
    >
      <img src="/hero_img.jpg" class="object-cover aspect-square" alt="" />
      <p class="font-mono text-black text-xs">corniche Brazzaville</p>
    </div>
  </div>
  <HeroComponent>
    <div slot="description" class="animate-blur-in animation-delay-300">
      <p>
        {t("home.description.prefix")}{" "}
        <a
          href="https://blog.eembouz.com/"
          class="underline hover:text-primary"
        >
          {t("home.description.link")}
        </a>
        {t("home.description.suffix")}{" "}
        <a
          href="mailto:contact@eembouz.com"
          class="underline hover:text-primary"
        >
          {t("home.contact")}
        </a>
      </p>
    </div>
  </HeroComponent>
</div>
