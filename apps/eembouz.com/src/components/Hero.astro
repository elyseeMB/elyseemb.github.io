---
import HeroComponent from "@portfolio/ui/Hero";
import { getTranslator } from "../libs/i18n.ts";
const __ = await getTranslator(Astro.currentLocale);
---

<HeroComponent title="Elysee Mboussa">
  <div slot="description" class="animate-blur-in animation-delay-300">
    <p>
      {
        __(
          "Ingénieur logiciel, Je conçois des solutions numériques fiables et durables. Sur Mon blog, je partage mon parcours créatif et technologique.",
        )
      }
    </p>
  </div>
</HeroComponent>
