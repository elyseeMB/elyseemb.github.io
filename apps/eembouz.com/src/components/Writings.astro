---
import { getCollection } from "astro:content";
import { useTranslations } from "../i18n/utils.ts";
import { prefixWithSlash } from "../functions/string.ts";

const writings = await getCollection(
  "writings",
  ({ data }) => data.status === "online",
);

const t = useTranslations(Astro.currentLocale);
---

<section
  class="writings flex flex-col gap-2 animate-blur-in animation-delay-300"
>
  <h2 data-h3-portfolio class="projects__title font-mono tracking-tighter">
    {prefixWithSlash(t("writings.title"))}
  </h2>
  <div class="flex flex-col text-[var(--color-secondary)]">
    {
      writings.map((writing) => (
        <div class="frameworks">
          <ul class="list">
            <li class="framework group cursor-pointer hover:text-[var(--color-primary)] transition">
              <a class="group block w-full" href={writing.id}>
                <span data-link class="relative framework__name">
                  {writing.data.title}
                  <span class="absolute left-full ml-2 top-1/2 -translate-y-1/2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ease-out"
                    >
                      <path d="M7 7h10v10" />
                      <path d="M7 17 17 7" />
                    </svg>
                  </span>
                </span>
              </a>
            </li>
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .writings {
    width: 100%;
    height: 100%;
    padding-bottom: 5rem;
  }
</style>
