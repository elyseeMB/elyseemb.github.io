---
import HeaderComponent from "@portfolio/ui/Header";
import { getTranslator } from "../../libs/i18n.ts";
const __ = await getTranslator(Astro.currentLocale);
---

<HeaderComponent>
  <ul class="flex-header actions">
    <li class="btn btn-link">
      <a
        href="https://blog.eembouz.com"
        class="btn-click magnetic link-header"
        data-strength="25"
        data-strength-text="10"
      >
        <span class="btn-text">
          <span class="btn-text-inner">
            {__("Blog")}
          </span>
        </span>
      </a>
    </li>

    <li class="btn btn-link">
      <a
        href="mailto:contact@eembouz.com"
        class="btn-click magnetic link-header"
        data-strength="25"
        data-strength-text="10"
      >
        <span class="btn-text">
          <span class="btn-text-inner">{__("contact")}</span>
        </span>
      </a>
    </li>
  </ul>
</HeaderComponent>

<style>
  ul.flex-header,
  ul.flex-header li {
    all: unset;
    white-space: nowrap;
  }

  ul li {
    display: flex;
    flex-direction: initial;
    align-items: center;
    text-decoration: none;
    list-style: none;
  }

  ul.flex-header.actions {
    display: flex;
    align-items: center;
  }

  .link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: background-color 0.3s;
    border-radius: var(--rounded);
    background-color: rgba(53, 53, 53, 0.249);
    padding: 0.5rem 0.8rem;
  }

  .link-header::before {
    position: absolute;
    content: "";
    top: 50px;
    display: block;
    background: var(--primary);
    opacity: 0;
    transform: scale(0);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;

    width: 7px;
    height: 7px;
  }

  .link-header:hover::before {
    opacity: 1;
    transform: scale(2);
  }
</style>
