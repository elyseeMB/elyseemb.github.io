---
import HeaderComponent from "@portfolio/ui/Header";
import { getLink, getTranslator } from "../../libs/i18n.ts";
const { pathname } = Astro.url;
const __ = await getTranslator(Astro.currentLocale);
const isMainPage = pathname === getLink(Astro, "/");
---

<HeaderComponent>
  <div slot="header-redirect">
    {
      !isMainPage && (
        <svg
          class="text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-undo2-icon lucide-undo-2"
        >
          <>
            <path d="M9 14 4 9l5-5" />
            <path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11" />
          </>
        </svg>
      )
    }
  </div>
  <ul class="flex-header actions">
    <li class="btn btn-link">
      <a
        target="_blank"
        href="https://blog.eembouz.com"
        class="btn-click magnetic link-header focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
        data-strength="25"
        data-strength-text="10"
      >
        <span class="btn-text">
          <span class="btn-text-inner">
            {__("Blog")}
          </span>
        </span>
      </a>
    </li>

    <li class="btn btn-link">
      <a
        href="mailto:contact@eembouz.com"
        class="btn-click magnetic link-header focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
        data-strength="25"
        data-strength-text="10"
      >
        <span class="btn-text">
          <span class="btn-text-inner">{__("contact")}</span>
        </span>
      </a>
    </li>
  </ul>
</HeaderComponent>

<style>
  ul.flex-header,
  ul.flex-header li {
    all: unset;
    white-space: nowrap;
  }

  ul li {
    display: flex;
    flex-direction: initial;
    align-items: center;
    text-decoration: none;
    list-style: none;
  }

  ul.flex-header.actions {
    display: flex;
    align-items: center;
  }

  .link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: background-color 0.3s;
    border-radius: var(--rounded);
    background-color: rgba(53, 53, 53, 0.249);
    padding: 0.5rem 0.8rem;
  }

  .link-header::before {
    position: absolute;
    content: "";
    top: 50px;
    display: block;
    background: var(--primary);
    opacity: 0;
    transform: scale(0);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;

    width: 7px;
    height: 7px;
  }

  .link-header:hover::before {
    opacity: 1;
    transform: scale(2);
  }
</style>
