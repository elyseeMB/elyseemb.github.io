---
import FooterComponent from "@portfolio/ui/Footer";
import { getLink, stripLocalePrefix, useTranslations, langs } from "../../i18n/utils.ts";
import { defaultLang, languages as languageNames } from "../../i18n/ui.ts";
import { prefixWithSlash } from "../../functions/string.ts";

const t = useTranslations(Astro.currentLocale);

const currentPath = stripLocalePrefix(Astro.url.pathname);
const languages = Object.entries(languageNames).map(([code, label]) => ({
  code,
  label,
  href: getLink(code, currentPath),
  current: code === Astro.currentLocale,
}));
---

<FooterComponent
  links={{
    title: prefixWithSlash(t("footer.networks")),
    items: [
      {
        title: "Github",
        href: "https://github.com/elyseeMB",
      },
      {
        title: "Linkedin",
        href: "https://www.linkedin.com/in/%CE%BEmmanuelito-mboussa-49099932a?utm_source=share&utm_campaign=share_via&utm_content=profile&utm_medium=ios_app",
      },
      {
        title: t("footer.stats"),
        href: "https://analytics.eembouz.com/share/UmUcMJfGKRHXxg3C",
      },
    ],
  }}
  contacts={{
    title: t("footer.contact"),
    items: [
      {
        title: t("footer.getInTouch"),
        href: "mailto:contact@eembouz.com",
      },
    ],
  }}
  property={{
    name: "eembouz.com",
    url: "https://eembouz.com",
  }}
  languages={languages}
  languageLabel={t("footer.language")}
/>
