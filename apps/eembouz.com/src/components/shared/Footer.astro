  links={{
    title: prefixWithSlash(__("Réseaux")),
    items: [
      {
        title: "Github",
        href: "https://github.com/elyseeMB",
      },
      {
        title: "Linkedin",
        href: "https://www.linkedin.com/in/%CE%BEmmanuelito-mboussa-49099932a?utm_source=share&utm_campaign=share_via&utm_content=profile&utm_medium=ios_app",
      },
      {
        title: __("Statistiques"),
        href: "https://analytics.eembouz.com/share/UmUcMJfGKRHXxg3C",
      },
    ],
  }}
  contacts={{
    title: __("Contact"),
    items: [
      {
        title: __("Entrer en contact"),
        href: "mailto:contact@eembouz.com",
      },
    ],
  }}
  property={{
    name: "eembouz.com",
    url: "https://eembouz.com",
  }}
/>
