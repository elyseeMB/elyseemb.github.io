---
import FooterComponent from "@portfolio/ui/Footer";
import { getLink, stripLocalePrefix, useTranslations } from "../../i18n/utils.ts";
import { defaultLang, languages as languageNames } from "../../i18n/ui.ts";
import footerData from "../../data/footer.json";

const t = useTranslations(Astro.currentLocale);

const currentPath = stripLocalePrefix(Astro.url.pathname);
const languages = Object.entries(languageNames).map(([code, label]) => ({
  code,
  label,
  href: getLink(code, currentPath),
  current: code === Astro.currentLocale,
}));

type FooterLocale = keyof (typeof footerData.networks)[number]["label"];
const locale = (Astro.currentLocale ?? defaultLang) as FooterLocale;

const resolveHref = (href: string) =>
  href.startsWith("/") ? getLink(Astro.currentLocale, href) : href;

const networks = footerData.networks.map((item) => ({
  title: item.label[locale] ?? item.label.en,
  href: resolveHref(item.href),
}));

const contacts = footerData.contacts.map((item) => ({
  title: item.label[locale] ?? item.label.en,
  href: resolveHref(item.href),
}));
---

<FooterComponent
  links={{
    title: t("footer.networks"),
    items: networks,
  }}
  contacts={{
    title: t("footer.contact"),
    items: contacts,
  }}
  property={{
    name: "eembouz.com",
    url: "https://eembouz.com",
  }}
  languages={languages}
  languageLabel={t("footer.language")}
/>
