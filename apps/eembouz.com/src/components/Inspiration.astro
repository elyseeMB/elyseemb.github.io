---
import { getCollection } from "astro:content";
import { useTranslations } from "../i18n/utils.ts";
import { prefixWithSlash } from "../functions/string.ts";
const inspirations = await getCollection("inspirations");
const t = useTranslations(Astro.currentLocale);
---

<section class="inspirations animate-blur-in animation-delay-300">
  <h2 data-h3-portfolio class="inspirations__title font-mono tracking-tighter">
    {prefixWithSlash(t("inspirations.title"))}
  </h2>
  <div class="flex flex-col text-[var(--color-secondary)]">
    {
      inspirations.map((inspiration) => (
        <div class="frameworks">
          <ul class="list">
            <li class="framework group cursor-pointer hover:text-[var(--color-primary)] transition">
              <a
                target="_blank"
                class="group block w-full"
                href={inspiration.data.link}
              >
                <span data-link class="relative framework__name">
                  {inspiration.data.title}
                  <span class="absolute left-full ml-2 top-1/2 -translate-y-1/2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ease-out"
                    >
                      <path d="M7 7h10v10" />
                      <path d="M7 17 17 7" />
                    </svg>
                  </span>
                </span>
              </a>
            </li>
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .inspirations__title {
    padding-bottom: 0.5rem;
  }

  .inspirations {
    width: 100%;
    height: 100%;
    padding-bottom: 5rem;
  }

  .inspirations ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .techo__name {
    font-family: "Inter" !important;
    letter-spacing: normal;
    font-weight: 100 !important;
    padding-bottom: 1rem;
  }

  .frameworks .list {
    display: flex;
    flex-direction: column;
    gap: 0;
    line-height: 1.6;
  }

  @media only screen and (min-width: 1370px) {
    .frameworks .list li {
      padding-bottom: 0.5rem;
      text-wrap: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      width: 700px;
      display: block;
    }
  }

  @media only screen and (max-width: 930px) {
    .frameworks .list li {
      padding-bottom: 0.5rem;
      text-wrap: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      width: 600px;
      display: block;
    }
  }

  @media only screen and (max-width: 700px) {
    .frameworks .list li {
      padding-bottom: 0.5rem;
      text-wrap: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      width: 400px;
      display: block;
    }
  }

  @media only screen and (max-width: 500px) {
    .frameworks .list li {
      padding-bottom: 0.5rem;
      text-wrap: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      width: 350px;
      display: block;
    }
  }

  .frameworks .list li {
    padding-bottom: 0.5rem;
    text-wrap: nowrap;
  }
</style>
