---
type Info = {
  title: string;
  description?: string;
};

type Link = {
  title: string;
  href: string;
};

type Property = {
  name: string;
  url: string;
};

interface Props {
  info?: Info;
  links?: {title:string; items: Link[]};
  contacts?: {title:string; items: Link[]};
  property?: Property;
}

const { info, links, contacts, property } = Astro.props;

const locale = Astro.currentLocale?.includes("fr") ? "/" : Astro.currentLocale;
const url = new URL(locale ?? "/en", Astro.url.origin);

---

<footer>
    <div class="grid-footer">

      <div class="font-serif text-base">
          <span class="lg:col-span-3"> 
           {info?.description}
          </span>

          <div class="legacy lg:row-start-2">
            <span class="declaration"
              >
              Copyright © <span id="footer-year"></span> elysee Mboussa . All rights reserved.</span
            >
          </div>
      </div>

      <!-- <div class="contacts lg:row-start-1 lg:col-span-4">
        <div class="btn-fixed">
          <div class="btn btn-round">
              <a href={contacts?.items[0].href} class="btn-click magnetic " data-strength="100" data-strength-text="50">
                  <div class="btn-fill"></div>
                  <span style="text-align: center;" class="btn-text">
                      <span class="btn-text-inner">
                        {contacts?.items[0].title}
                      </span>
                  </span>
              </a>
      </div>
      </div>
    </div> -->

      <div class="right">
        <div>
          <div class="flex flex-col gap-5">
            { links && (
              <h4 class="font-mono tracking-tighter uppercase">{links.title}
              </h4>
              <ul class="flex flex-col gap-5 text-base">
                {
                  links &&
                    links.items.map((link) => (
                       <li class="group relative framework text-[var(--color-secondary)]  hover:text-[var(--color-primary)] transition">
                          <a
                            class="absolute inset-0 rounded-lg z-10"
                            href={link.href}
                            aria-label={link.title}
                          />

                          <div class="relative inline-block pointer-events-none">
                            <span data-link class="framework__name">
                              {link.title}
                            </span>

                            <span class="absolute left-full ml-2 top-1/2 -translate-y-1/2">
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ease-out"
                              >
                                <path d="M7 7h10v10" />
                                <path d="M7 17 17 7" />
                              </svg>
                            </span>
                          </div>
                        </li>
                    ))
                }
              </ul>
            )
          }
          </div>
        </div>
      </div>
    </div>
</footer>

<style scoped>


  footer {
    /* padding-bottom: 10rem; */
  }


  footer {
    display: grid;
  }

  footer p {
    padding: 0;
    margin: 0;
    color: var(--color-primary);
    text-wrap: balance;
  }




  .grid-footer {
    display: flex;
    gap: 2rem;
    flex-direction: column-reverse;
    align-items: flex-start;
    justify-content: center;
  }

  footer .grid-footer .left {
    width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 2rem;
    }
  


  .newsletter {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }



  footer .contacts {
    margin-block: 2rem;
    width: 100%;
    border-bottom: 1px solid var(--secondary);
    position: relative;
  }
  
  .contacts ul li  {
    /* color: var(--color-primary) ; */
  }

  .legacy {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    color: var(--muted-foreground);
  }

  .legacy .declaration {
    text-wrap: nowrap;
  }

  .legacy a {
    color: var(--color-secondary);
    display: block;
    width: max-content;
  }

  .legacy a:hover {
    text-decoration: underline;
  }

  .info a > * {
    color:  var(--color-primary);
  }

  .links ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .links a:hover {
    text-decoration: underline;
  }

</style>





<script>
  import {onLoadClientRouter} from "@portfolio/ui/client"

  onLoadClientRouter(() => {
    document.getElementById("footer-year").innerText = new Date().getFullYear();
  })
</script>
