---
interface Props {
  action?: {
    name: string;
    url: string;
  };
  title: string;
  description?: string;
  job?: string;
}

const { title, description, action } = Astro.props;
---

<section class="hero flex flex-col gap-5">
  <div class="title">
    <h1 class="split">
      {title}
    </h1>
    <slot name="description" />
  </div>

  {
    action && (
      <div class="about description animate-fade-in animation-delay-300">
        <div class="btn-fixed">
          <div class="btn btn-round is-inview">
            <a
              href={action.url}
              class="btn-click magnetic"
              data-strength="100"
              data-strength-text="50"
            >
              <div class="btn-fill" />
              <span class="btn-text" style="transform: rotate(0.001deg);">
                <span class="btn-text-inner text-center">{action.name}</span>
              </span>
            </a>
          </div>
        </div>
      </div>
    )
  }
</section>

<style>
  .about .btn-fixed {
    position: absolute;
    right: 0;
    top: 0;
    transform: translate(-50%, -50%);
    z-index: 20;
  }

  .about {
    margin-top: 5rem;
    font-size: 0.8rem;
    position: relative;
    border-bottom: 1px solid var(--border);
  }

  .wrapper-description {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }

  /* Desktop (769px et plus) */
  @media only screen and (min-width: 769px) {
    .wrapper {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(500px, 1fr));
      place-items: flex-start;
    }
  }
</style>
