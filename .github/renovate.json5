{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "schedule:monthly", "group:allNonMajor"],
  labels: ["dependencies"],
  rangeStrategy: "bump",
  postUpdateOptions: ["pnpmDedupe"],
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      matchDepTypes: ["peerDependencies"],
      enabled: false,
    },
    {
      groupName: "astro",
      matchPackageNames: [
        "astro",
        "@astrojs/markdoc",
        "@astrojs/mdx",
        "@astrojs/preact",
        "@astrojs/rss",
        "@astrojs/sitemap",
      ],
    },
    {
      groupName: "preact",
      matchPackageNames: ["preact", "@preact/preset-vite"],
    },
    {
      groupName: "tailwind",
      matchPackageNames: [
        "tailwindcss",
        "@tailwindcss/vite",
        "@tailwindcss/typography",
      ],
    },
    {
      matchUpdateTypes: ["major"],
      schedule: ["* 0-3 * * 1"],
    },
  ],
  ignoreDeps: [
    // manually bumping
    "node",
    "pnpm",
  ],
}
