{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly", "group:allNonMajor"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "postUpdateOptions": ["pnpmDedupe"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "groupName": "astro ecosystem",
      "matchPackageNames": [
        "astro",
        "@astrojs/markdoc",
        "@astrojs/mdx",
        "@astrojs/preact",
        "@astrojs/rss",
        "@astrojs/sitemap"
      ]
    },
    {
      "groupName": "preact ecosystem",
      "matchPackageNames": ["preact", "@preact/preset-vite"]
    },
    {
      "groupName": "tailwind ecosystem",
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/vite",
        "@tailwindcss/typography"
      ]
    }
  ],
  "ignoreDeps": [
    // manually bumping
    "node",
    "pnpm"
  ]
}
